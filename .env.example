# SALIN file ini menjadi .env (lokal) atau isi sebagai Variable di Railway.
# JANGAN PERNAH commit file .env yang sudah terisi.
# Semua nilai di bawah ini KOSONG / contoh — isi dengan nilai ASLI dari akunmu sendiri.

# WAJIB. Secret HMAC 32-byte dari dashboard Agent Games saat registrasi agent
# (menu "Rotate Secret" — ditampilkan SEKALI saja, simpan baik-baik).
AGENT_GAMES_HMAC_SECRET=

# OPSIONAL (tapi sangat disarankan). API key Kurier mainnet — minta di https://kurier.xyz
# Kalau kosong, agent tetap jalan dan tetap menjawab task, tapi proof tidak
# disubmit ke Kurier (lihat README bagian "Yang belum selesai").
KURIER_API_KEY=

# OPSIONAL. Default sudah benar (dari contoh kode di halaman /build).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# OPSIONAL. Default sudah benar (dari /api/circuit-info, mainnet).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# OPSIONAL. Port server. Railway mengisi PORT sendiri secara otomatis.
PORT=3000

# OPSIONAL. Batas aman internal (ms) — harus di bawah 60 detik platform.
RESPONSE_DEADLINE_MS=55000
PROOF_TIMEOUT_MS=30000

# OPSIONAL. Path file penyimpanan proof/task yang sudah dijawab.
SEEN_STORE_PATH=./data/seen.json
